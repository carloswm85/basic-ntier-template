root = true

# Repository-wide text policy.
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Preserve trailing spaces that can be meaningful in Markdown.
[*.md]
trim_trailing_whitespace = false

# Preserve upstream indentation in vendored browser libraries.
[**/wwwroot/lib/**]
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
