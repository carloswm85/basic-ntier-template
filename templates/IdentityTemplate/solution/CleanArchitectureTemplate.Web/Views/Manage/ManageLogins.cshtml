@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.ManageViewModels

@model ManageLoginsViewModel

@{
    ViewData["Title"] = "Manage your external logins";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(ViewData["StatusMessage"] as string))
{
    <div class="alert alert-success">
        @ViewData["StatusMessage"]
    </div>
}

@if (Model.CurrentLogins?.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Registered logins</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <tbody>
                        @for (var index = 0; index < Model.CurrentLogins.Count; index++)
                        {
                            <tr>
                                <td>
                                    @Model.CurrentLogins[index].ProviderDisplayName
                                </td>
                                <td class="text-end">
                                    @if (ViewData["ShowRemoveButton"] as bool? == true)
                                    {
                                        <form asp-controller="Manage"
                                              asp-action="RemoveLogin"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="LoginProvider"
                                                   value="@Model.CurrentLogins[index].LoginProvider" />

                                            <input type="hidden"
                                                   name="ProviderKey"
                                                   value="@Model.CurrentLogins[index].ProviderKey" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Remove this login provider">
                                                Remove
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body border-start border-secondary border-3 ps-3">
            <div class="d-flex align-items-start gap-2 text-muted">
                <i class="bi bi-info-circle fs-5"></i>
                <div>
                    <p class="mb-1 fw-bolder">
                        You haven’t linked any external login providers yet.
                    </p>
                    <small>
                        External logins let you sign in faster using trusted third-party services.
                    </small>
                </div>
            </div>
        </div>
    </div>
}



@if (Model.OtherLogins?.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Add another login provider</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Manage"
                  asp-action="LinkLogin"
                  method="post">

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var provider in Model.OtherLogins)
                    {
                        <button type="submit"
                                class="btn btn-outline-secondary"
                                name="provider"
                                value="@provider.Name"
                                title="Sign in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body border-start border-secondary border-3 ps-3">
            <div class="d-flex align-items-start gap-2 text-muted">
                <i class="bi bi-info-circle fs-5"></i>
                <div>
                    <p class="mb-1 fw-bolder">
                        There are no additional external login providers available to add.
                    </p>
                    <small>
                        All supported external providers are already linked to your account.
                    </small>
                </div>
            </div>
        </div>
    </div>
}
