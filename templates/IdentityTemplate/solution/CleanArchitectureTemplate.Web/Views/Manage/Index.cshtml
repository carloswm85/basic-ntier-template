@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.ManageViewModels

@model IndexViewModel

@{
    ViewData["Title"] = "Manage your account";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="mb-3">@ViewData["Title"]</h1>

            @if (!string.IsNullOrWhiteSpace(ViewData["StatusMessage"] as string))
            {
                <div class="alert alert-success">
                    @ViewData["StatusMessage"]
                </div>
            }


            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Account settings</h5>
                </div>

                <ul class="list-group list-group-flush">

                    <!-- Password -->
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Password</strong>
                        </div>
                        <div>
                            @if (Model.HasPassword)
                            {
                                <a asp-controller="Manage"
                                   asp-action="ChangePassword"
                                   class="btn btn-sm btn-outline-primary">
                                    Change
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Manage"
                                   asp-action="SetPassword"
                                   class="btn btn-sm btn-outline-primary">
                                    Create
                                </a>
                            }
                        </div>
                    </li>

                    <!-- External Logins -->
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>External logins</strong>
                            <div class="text-muted small">
                                @Model.Logins.Count configured
                            </div>
                        </div>
                        <a asp-controller="Manage"
                           asp-action="ManageLogins"
                           class="btn btn-sm btn-outline-secondary">
                            Manage
                        </a>
                    </li>

                    <!-- Phone Number -->
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Phone number</strong>
                                <div class="text-muted small">
                                    Used for two-factor authentication via SMS.
                                    See
                                    <a href="http://go.microsoft.com/fwlink/?LinkID=532713"
                                       target="_blank"
                                       rel="noopener">
                                        this article
                                    </a>
                                    for configuring this ASP.NET application.
                                </div>
                                <div class="mt-1">
                                    @(Model.PhoneNumber ?? "None")
                                </div>
                            </div>

                            <div class="text-end">
                                @if (Model.PhoneNumber != null)
                                {
                                    <a asp-controller="Manage"
                                       asp-action="AddPhoneNumber"
                                       class="btn btn-sm btn-outline-primary mb-1">
                                        Change
                                    </a>

                                    <form asp-controller="Manage"
                                          asp-action="RemovePhoneNumber"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Remove
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Manage"
                                       asp-action="AddPhoneNumber"
                                       class="btn btn-sm btn-outline-primary">
                                        Add
                                    </a>
                                }
                            </div>
                        </div>
                    </li>

                    <!-- Two-Factor Authentication -->
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Two-factor authentication</strong>
                            <div class="text-muted small">
                                @(Model.TwoFactor ? "Enabled" : "Disabled")
                            </div>
                        </div>

                        @if (Model.TwoFactor)
                        {
                            <form asp-controller="Manage"
                                  asp-action="DisableTwoFactorAuthentication"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Disable
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Manage"
                                  asp-action="EnableTwoFactorAuthentication"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    Enable
                                </button>
                            </form>
                        }
                    </li>

                    <!-- Authenticator App -->
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Authenticator app</strong>

                                @if (Model.AuthenticatorKey != null)
                                {
                                    <div class="text-muted small mt-1">
                                        Key
                                    </div>
                                    <code class="d-block mt-1">
                                        @Model.AuthenticatorKey
                                    </code>
                                }
                            </div>

                            <div class="text-end">
                                @if (Model.AuthenticatorKey == null)
                                {
                                    <form asp-controller="Manage"
                                          asp-action="ResetAuthenticatorKey"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Generate key
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Manage"
                                          asp-action="GenerateRecoveryCode"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Generate recovery codes
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </li>

                </ul>
            </div>

        </div>
    </div>
</div>
