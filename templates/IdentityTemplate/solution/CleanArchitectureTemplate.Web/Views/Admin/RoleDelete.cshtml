@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.AdminViewModels

@model RoleViewModel

@{
    ViewData["Title"] = "Delete Role";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 col-xl-6 mx-auto">

            <!-- Danger alert -->
            <div class="alert alert-danger border-danger shadow-sm" role="alert">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div>
                        <h4 class="alert-heading mb-1">Confirm Delete Role</h4>
                        <p class="mb-0">
                            Are you sure you want to delete this role? This action cannot be undone.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Role information -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-x me-2"></i>Role Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12">
                            <div class="border-start border-danger border-4 ps-3">
                                <h6 class="text-muted mb-1">Role Name</h6>
                                <p class="mb-0 fw-semibold">@Model.Name</p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border-start border-danger border-4 ps-3">
                                <h6 class="text-muted mb-1">Public</h6>
                                <span class="badge @(Model.IsPublic ? "bg-success" : "bg-secondary")">
                                    <i class="bi @(Model.IsPublic ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                    @(Model.IsPublic ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border-start border-danger border-4 ps-3">
                                <h6 class="text-muted mb-1">Default</h6>
                                <span class="badge @(Model.IsDefault ? "bg-info text-dark" : "bg-secondary")">
                                    <i class="bi @(Model.IsDefault ? "bi-star-fill" : "bi-star") me-1"></i>
                                    @(Model.IsDefault ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border-start border-danger border-4 ps-3">
                                <h6 class="text-muted mb-1">Static</h6>
                                <span class="badge @(Model.IsStatic ? "bg-warning text-dark" : "bg-secondary")">
                                    <i class="bi @(Model.IsStatic ? "bi-lock-fill" : "bi-unlock") me-1"></i>
                                    @(Model.IsStatic ? "Yes" : "No")
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Info card -->
            <div class="card shadow-sm border-warning mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-info-circle-fill text-warning fs-4 me-3 mt-1"></i>
                        <div>
                            <h6 class="mb-2">What happens when you delete this role?</h6>
                            <ul class="mb-0 small">
                                <li>The role will be permanently removed</li>
                                <li>Users assigned to this role will lose it</li>
                                <li>Permissions associated with the role will no longer apply</li>
                                <li>This action cannot be reversed</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <form asp-action="RoleDelete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="RoleList" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left me-2"></i>No, Keep Role
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-trash me-2"></i>Yes, Delete Role
                            </button>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>
