@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.AdminViewModels

@model UserRolesEditViewModel

@{
    ViewData["Title"] = "Edit User Roles";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-10 col-xl-8 mx-auto">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-person-gear me-2"></i>Edit User Roles
                </h2>
            </div>

            <hr />

            <form asp-action="UserRolesEdit" method="post">
                <input type="hidden" asp-for="UserId" />

                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-person-badge me-2"></i>User Information
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="text-muted small">Full name</div>
                                <div class="fw-semibold">
                                    @Model.FullName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Username</div>
                                <div class="fw-semibold">
                                    @Model.UserName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Email</div>
                                <div class="fw-semibold">
                                    @Model.Email
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">User ID</div>
                                <div class="font-monospace small text-muted">
                                    @Model.UserId
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-shield-lock me-2"></i>Assigned Roles
                        </h5>
                    </div>

                    @*
                        User: basic access for end-users
                        Manager: team oversight and reporting
                        Admin: system configuration and user management
                        SuperAdmin: full system control and critical operations
                    *@

                    <div class="card-body">
                        <div class="row g-3">
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-check form-switch">
                                        <input asp-for="Roles[i].IsAssigned"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch" />

                                        <label class="form-check-label fw-semibold">
                                            @Model.Roles[i].RoleName
                                        </label>

                                        <input type="hidden" asp-for="Roles[i].RoleId" />
                                        <input type="hidden" asp-for="Roles[i].RoleName" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-1 mt-4">
                    <a asp-action="UserList" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to User List
                    </a>

                    <a asp-action="UserDetails" asp-route-id="@Model.UserId"
                        class="btn btn-outline-secondary me-auto" target="_blank">
                        <i class="bi bi-arrow-up-right"></i> See User Details
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
