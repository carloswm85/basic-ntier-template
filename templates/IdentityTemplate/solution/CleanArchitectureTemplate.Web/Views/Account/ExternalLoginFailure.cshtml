@{
    ViewData["Title"] = "Login Failure";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="alert alert-danger d-flex align-items-start gap-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div>
                <h1 class="h4 mb-1">@ViewData["Title"]</h1>
                <p class="mb-0">
                    We couldn’t sign you in using the selected external service.
                    Please try again or choose a different login method.
                </p>
            </div>
        </div>
    </div>
</div>
