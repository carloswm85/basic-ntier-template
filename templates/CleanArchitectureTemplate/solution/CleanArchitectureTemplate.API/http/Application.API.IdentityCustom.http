@AccountApi_HostAddress = http://localhost:5018

# =========================================================
#  AccountApiController - Custom Identity API (JWT)
#  Route base: /api/AccountApi
#  Test user:  user@email.com / CleanArchitectureTemplate!123
# =========================================================

@user_variation = 5
@email = "user{{user_variation}}@email.com"
@phone_number = "+541112345678"
@default_password = "CleanArchitectureTemplate!456"

@user_id = USER_ID
@email_confirmation_token = EMAIL_CONFIRMATION_TOKEN

@access_token = ACCESS_TOKEN
@refresh_token = REFRESH_TOKEN

@new_password = "NewPass!abc123"
@newest_password = "NewestPass!abc123"
@reset_token = RESET_TOKEN

# =========================================================
#  REGISTRATION and EMAIL CONFIRMATION
# =========================================================

### [1] ✅ Register new user
# [AllowAnonymous] POST api/AccountApi/register
POST {{AccountApi_HostAddress}}/api/AccountApi/register
Accept: application/json
Content-Type: application/json

{
  "FirstName": "Name",
  "LastName": "Surname",
  "City": "Mycity",
  "Email": {{email}},
  "Password": {{default_password}}
}

###

### [2] ✅ Get email confirmation token — DEBUG
# [AllowAnonymous] POST api/AccountApi/confirmEmailDataDeveloper
# Returns: UserId + raw ConfirmationToken — copy both below
POST {{AccountApi_HostAddress}}/api/AccountApi/confirmEmailGetTokenDeveloper
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}}
}

###

### [3] ✅ Confirmation email — PRODUCTION
# [AllowAnonymous] GET api/AccountApi/confirmEmail
# Replace <USER_ID> and <CONFIRMATION_TOKEN> with values from step [2]
GET {{AccountApi_HostAddress}}/api/AccountApi/confirmEmail?userId={{user_id}}&token={{email_confirmation_token}}
Accept: application/json

###

### [4] ✅ Resend confirmation email
# [AllowAnonymous] POST api/AccountApi/resendConfirmationEmail
POST {{AccountApi_HostAddress}}/api/AccountApi/resendConfirmationEmail
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}}
}

###

# =========================================================
#  AUTHENTICATION
# =========================================================

### [5] ✅ Login — standard (no 2FA)
# [AllowAnonymous] POST api/AccountApi/login
# Returns: AccessToken + RefreshToken — populate @access_token / @refresh_token above
POST {{AccountApi_HostAddress}}/api/AccountApi/login
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}},
  "Password": {{default_password}}
}

###

### [6] ⚠️ Login — with 2FA TOTP code
# [AllowAnonymous] POST api/AccountApi/login
POST {{AccountApi_HostAddress}}/api/AccountApi/login
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}},
  "Password": {{default_password}},
  "TwoFactorCode": "<CODE>"
}

###

### [7] ⚠️ Login — with 2FA recovery code
# [AllowAnonymous] POST api/AccountApi/login
POST {{AccountApi_HostAddress}}/api/AccountApi/login
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}},
  "Password": {{default_password}},
  "TwoFactorRecoveryCode": "<RECOVERY_CODE>"
}

###

### [8] ✅ Refresh access token
# [AllowAnonymous] POST api/AccountApi/refresh
# Rotates both access and refresh tokens
POST {{AccountApi_HostAddress}}/api/AccountApi/refresh
Accept: application/json
Content-Type: application/json

{
  "AccessToken": "{{access_token}}",
  "RefreshToken": "{{refresh_token}}"
}

###

### [9] Logout — current device/session
# [Authorize] POST api/AccountApi/logout
# Requires valid Bearer + matching RefreshToken
POST {{AccountApi_HostAddress}}/api/AccountApi/logout
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "RefreshToken": "{{refresh_token}}"
}

###

### [10] ✅ Logout — all devices
# [Authorize] POST api/AccountApi/logout/all
# Invalidates all refresh tokens for the user
POST {{AccountApi_HostAddress}}/api/AccountApi/logout/all
Accept: application/json
Authorization: Bearer {{access_token}}

###


# =========================================================
#  PASSWORD MANAGEMENT
# =========================================================

### [11] ✅ Forgot password — DEBUG only
# [AllowAnonymous] POST api/AccountApi/forgotPasswordDeveloper
# Returns: EncodedToken + ResetLink — copy EncodedToken below
POST {{AccountApi_HostAddress}}/api/AccountApi/forgotPasswordDeveloper
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}}
}

###

### [12] ⚠️ Forgot password
# [AllowAnonymous] POST api/AccountApi/forgotPassword
POST {{AccountApi_HostAddress}}/api/AccountApi/forgotPassword
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}}
}

###

### [13] ✅ Reset password
# [AllowAnonymous] POST api/AccountApi/resetPassword
# Replace <ENCODED_RESET_TOKEN> with EncodedToken from step [11]
POST {{AccountApi_HostAddress}}/api/AccountApi/resetPassword
Accept: application/json
Content-Type: application/json

{
  "Email": {{email}},
  "Token": {{reset_token}},
  "NewPassword": {{new_password}}
}

###


# =========================================================
#  ACCOUNT MANAGEMENT  (requires [Authorize])
# =========================================================

### [14] ✅ Get user info
# [Authorize] GET api/AccountApi/manage/info
GET {{AccountApi_HostAddress}}/api/AccountApi/manage/info
Accept: application/json
Authorization: Bearer {{access_token}}

###

### [15] ✅ Update user info — phone number
# [Authorize] PATCH api/AccountApi/manage/info
PATCH {{AccountApi_HostAddress}}/api/AccountApi/manage/info
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "PhoneNumber": {{phone_number}}
}

###

### [16] ✅ Update user info — change password
# [Authorize] PATCH api/AccountApi/manage/info
PATCH {{AccountApi_HostAddress}}/api/AccountApi/manage/info
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "CurrentPassword": {{new_password}},
  "NewPassword": {{newest_password}}
}

###


# =========================================================
#  TWO-FACTOR AUTHENTICATION (2FA)  (requires [Authorize])
# =========================================================

### [17] ⚠️ 2FA — Generate setup key + QR URI (case GenerateSetup)
# [Authorize] POST api/AccountApi/manage/2fa
POST {{AccountApi_HostAddress}}/api/AccountApi/manage/2fa
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "TwoFactorAction": "GenerateSetup"
}

###

### [18] ⚠️ 2FA — Verify TOTP code and enable (case VerifyAndEnable)
# [Authorize] POST api/AccountApi/manage/2fa
# Replace <TOTP_CODE> with the 6-digit code from your authenticator app
POST {{AccountApi_HostAddress}}/api/AccountApi/manage/2fa
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "TwoFactorAction": "VerifyAndEnable",
  "VerificationCode": "<TOTP_CODE>"
}

###

### [19] ⚠️ 2FA — Disable (case Disable)
# [Authorize] POST api/AccountApi/manage/2fa
POST {{AccountApi_HostAddress}}/api/AccountApi/manage/2fa
Accept: application/json
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "TwoFactorAction": "Disable"
}

###
