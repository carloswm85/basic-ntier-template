@CleanArchitectureTemplate.Server_HostAddress = http://localhost:5018

# NOTE: Work correctly withOUT JWT

### Register
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/register
Accept: application/json
Content-Type: application/json

{
  "email": "user2@test.com",
  "password": "P@ssw0rd!",
  "confirmPassword": "P@ssw0rd!"
}

### WITH OPAQUE BEARER TOKENS #############################################

### Login - Without query parameters
# Returns: Bearer tokens
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/login
Accept: application/json
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "P@ssw0rd!"
}

