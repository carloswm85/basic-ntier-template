### WITHOUT BEARER TOKENS #################################################

### Login - With query parameters
# Returns: No bearer tokens, only 200 OK
# bool? useCookies: When true, the endpoint does a standard cookie-based login, and doesn't return access tokens
@useCookies = true
# bool? useSessionCookies: When false, the cookies are set as "session" cookies, so they are removed when you close your browser.
@useSessionCookies = true
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/login?useCookies={{useCookies}}&useSessionCookies={{useSessionCookies}}
Accept: application/json
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "P@ssw0rd!"
}

###

### LogOut - At AccountApiController
# 
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/AccountApi/logout
Accept: application/json
Content-Type: application/json

### OTHER #################################################################

### Refresh token
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/refresh
Accept: application/json
Content-Type: application/json

{
  "refreshToken": "<REFRESH_TOKEN>"
}

###

### Confirm email
GET {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/confirmEmail?userId=<USER_ID>&code=<CONFIRMATION_CODE>
Accept: application/json

###

### Resend confirmation email
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/resendConfirmationEmail
Accept: application/json
Content-Type: application/json

{
  "email": "user@test.com"
}

###

### Forgot password
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/forgotPassword
Accept: application/json
Content-Type: application/json

{
  "email": "user@test.com"
}

###

### Reset password
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/resetPassword
Accept: application/json
Content-Type: application/json

{
  "email": "user@test.com",
  "resetCode": "<RESET_CODE>",
  "newPassword": "NewP@ssw0rd!"
}

###

### Enable / disable 2FA
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/manage/2fa
Accept: application/json
Authorization: Bearer <ACCESS_TOKEN>

{
  "enable": true
}

###

### Get user info
GET {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/manage/info
Accept: application/json
Authorization: Bearer <ACCESS_TOKEN>

###

### Update user info
POST {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/manage/info
Accept: application/json
Authorization: Bearer <ACCESS_TOKEN>
Content-Type: application/json

{
  "email": "newemail@test.com",
  "phoneNumber": "+5491112345678"
}

###

### Get profile
GET {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/profile
Accept: application/json
Authorization: Bearer <ACCESS_TOKEN>

###

### Get profile
GET {{CleanArchitectureTemplate.Server_HostAddress}}/api/identity/profile
Accept: application/json
