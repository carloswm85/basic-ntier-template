@using CleanArchitectureTemplate.Web.Models
@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.AdminViewModels

@model PaginatedListViewModel<_UserListItemViewModel>

@{
    ViewData["Title"] = "User List";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-11 col-xl-10 mx-auto">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h2 class="mb-0">
                    <i class="bi bi-people-fill me-2"></i>@ViewData["Title"]
                </h2>

                <a asp-controller="Admin"
                   asp-action="UserCreate"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Create New User
                </a>
            </div>

            <hr />

            <!-- Filters -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-funnel-fill me-2"></i>Filters
                    </h5>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-3">

                        <!-- Page Size -->
                        <div>
                            <label for="PageSize" class="form-label fw-semibold">
                                Page Size
                            </label>

                            <select id="PageSize"
                                    class="form-select w-auto"
                                    onchange="location = this.value;">

                                @{
                                    int[] sizes = new[] { 5, 10, 25, 50, 100 };
                                }

                                @foreach (var size in sizes)
                                {
                                    string? url = Url.Action("UserList", new
                                    {
                                        currentFilter = Model.CurrentFilter,
                                        pageIndex = 1,
                                        pageSize = size,
                                        searchString = Model.CurrentFilter,
                                        sortOrder = Model.CurrentSort
                                    });

                                    var selected = Model.PageSize == size ? "selected" : "";
                                    <option value="@url"
                                            selected="@selected">
                                        @size
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Search -->
                        <form asp-action="UserList" method="get">
                            <div class="row g-2 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label fw-semibold">
                                        Search
                                    </label>

                                    <div class="input-group">
                                        <input type="hidden" name="sortOrder" value="@Model.CurrentSort" />
                                        <input type="hidden" name="pageIndex" value="1" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                        <input type="text"
                                               name="SearchString"
                                               value="@Model.CurrentFilter"
                                               class="form-control"
                                               placeholder="Name or username" />

                                        @if (!string.IsNullOrWhiteSpace(Model.CurrentFilter))
                                        {
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.CurrentSort"
                                               asp-route-pageSize="@Model.PageSize"
                                               class="btn btn-outline-secondary">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div class="col-auto">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>

                                <div class="col-auto">
                                    <a asp-action="UserList" class="btn btn-secondary">
                                        Reset
                                    </a>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- Empty State -->
            @if (!Model.PaginatedList.Any())
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    No users found.
                </div>
            }
            else
            {
                <!-- Users Table -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>User List
                        </h5>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="align-middle">
                                        <th>#</th>
                                        <th>
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.SortColumnOne"
                                               asp-route-pageIndex="@Model.PaginatedList.PageIndex"
                                               asp-route-currentFilter="@Model.CurrentFilter"
                                               asp-route-pageSize="@Model.PageSize">
                                                @Html.DisplayNameFor(model => model.PaginatedList[0].LastName)
                                            </a>
                                        </th>
                                        <th> @Html.DisplayNameFor(model => model.PaginatedList[0].FirstName) </th>
                                        <th>
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.SortColumnTwo"
                                               asp-route-pageIndex="@Model.PaginatedList.PageIndex"
                                               asp-route-currentFilter="@Model.CurrentFilter"
                                               asp-route-pageSize="@Model.PageSize">
                                                @Html.DisplayNameFor(model => model.PaginatedList[0].UserName)
                                            </a>
                                        </th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].Roles)</th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].IsActive)</th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].EmailConfirmed)</th>
                                        <th>Lockout</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @{
                                        int rowNumber = 1;
                                    }

                                    @foreach (var item in Model.PaginatedList)
                                    {
                                        <tr>
                                            <td><b>@(rowNumber++)</b></td>
                                            <td>@item.LastName</td>
                                            <td>@item.FirstName</td>

                                            <td>
                                                <strong>@item.UserName</strong>
                                                @if (item.Email != item.UserName)
                                                {
                                                    <div class="text-muted small">@item.Email</div>
                                                }
                                            </td>

                                            <td>
                                                @if (!item.Roles.Any())
                                                {
                                                    <span class="text-muted fst-italic">—</span>
                                                }
                                                else
                                                {
                                                    foreach (var role in item.Roles)
                                                    {
                                                        <span class="badge bg-info text-dark me-1 mb-1">
                                                            @role
                                                        </span>
                                                    }
                                                }
                                            </td>

                                            <td>
                                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                                    @(item.IsActive ? "Yes" : "No")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge @(item.EmailConfirmed ? "bg-success" : "bg-secondary")">
                                                    @(item.EmailConfirmed ? "Yes" : "No")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge @(item.LockoutEnabled ? "bg-warning" : "bg-secondary")">
                                                    @(item.LockoutEnabled ? "Enabled" : "Disabled")
                                                </span>
                                                <br />
                                                <span class="badge @(item.LockoutEnd != null ? "bg-danger" : "bg-secondary")">
                                                    @(item.LockoutEnd != null ? "Active" : "Inactive")
                                                </span>
                                            </td>

                                            <td>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a asp-action="UserEdit"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-primary"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Edit user">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>

                                                    <a asp-action="UserDetails"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-info"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Display user details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a asp-action="UserDelete"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-danger"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Delete user">
                                                        <i class="bi bi-trash"></i>
                                                    </a>

                                                    <a asp-action="UserRolesEdit"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-secondary"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Edit user roles">
                                                        <i class="bi bi-person-gear"></i>
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Pagination Footer -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.PaginatedList.PageIndex == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="1"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize">
                                    First
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginatedList.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@(Model.PaginatedList.PageIndex - 1)"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize">
                                    Previous
                                </a>
                            </li>

                            <li class="page-item disabled">
                                <span class="page-link">
                                    Page @Model.PaginatedList.PageIndex of @Model.PaginatedList.TotalPages
                                </span>
                            </li>

                            <li class="page-item @(Model.PaginatedList.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@(Model.PaginatedList.PageIndex + 1)"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize">
                                    Next
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginatedList.PageIndex == Model.PaginatedList.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@Model.PaginatedList.TotalPages"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize">
                                    Last
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <div class="text-muted">
                        <i class="bi bi-bar-chart-fill me-1"></i>
                        <strong>@Model.PaginatedList.TotalRecords</strong> total,
                        <strong>@Model.PaginatedList.FilteredCount</strong> filtered,
                        <strong>@Model.PaginatedList.Count</strong> visible
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_BootstrapTooltips")
}
