@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Admin

@model UserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-person-plus me-2"></i>Create User
                </h2>
            </div>

            <form asp-action="UserCreate" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <input type="hidden" asp-for="Id" value="00000000-0000-0000-0000-000000000000" />

                <!-- ===================== BASIC INFORMATION ===================== -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>Basic Information
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <!-- Username -->
                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label fw-semibold">
                                        Username <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>

                                <!-- Active -->
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                                </div>
                                <small class="text-muted d-block mt-1">User can log in immediately</small>
                            </div>

                            <div class="col-md-6 text-center">
                                <!-- Image Preview (Default or Existing) -->
                                <div>
                                    <div class="mb-3">
                                        <img id="previewImage"
                                            src="@(string.IsNullOrEmpty(Model?.ImagePath)
                                                ? Url.Content("~/images/defaults/default-person.png")
                                                : Url.Content(Model.ImagePath))"
                                            alt="User profile"
                                            class="img-thumbnail"
                                            style="max-width: 150px;" />
                                    </div>

                                    <!-- Replace Image -->
                                    <div class="text-start">
                                        <label class="form-label fw-semibold">Add user image</label>
                                        <input asp-for="Image"
                                               type="file"
                                               class="form-control"
                                               accept="image/*"
                                               onchange="previewFile(event)" />
                                        <span asp-validation-for="Image" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <!-- First Name -->
                            <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label fw-semibold">
                                        First Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label fw-semibold">
                                        Last Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <!-- City -->
                            <div class="col-md-6">
                                    <label asp-for="City" class="form-label fw-semibold">
                                        City <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="City" class="form-control" placeholder="Enter city" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ===================== CONTACT INFORMATION ===================== -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-envelope me-2"></i>Contact Information
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <!-- Email -->
                            <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold">
                                        Email <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-envelope"></i>
                                        </span>
                                        <input asp-for="Email"
                                               type="email"
                                               class="form-control"
                                               placeholder="user@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Email Confirmed -->
                            <div class="col-md-6 d-flex flex-column justify-content-center">
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="EmailConfirmed" class="form-check-input" />
                                    <label asp-for="EmailConfirmed" class="form-check-label fw-semibold"></label>
                                </div>
                                <small class="text-muted mt-1">Not recommended</small>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-telephone"></i>
                                        </span>
                                        <input asp-for="PhoneNumber"
                                               type="tel"
                                               class="form-control"
                                               placeholder="+1 (555) 123-4567" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ===================== FOOTER ===================== -->
                <div class="card shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center py-3">

                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Fields marked with <span class="text-danger">*</span> are required
                        </small>

                        <div class="d-flex gap-2">
                            <a asp-action="UserList" class="btn btn-secondary">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Create User
                            </button>
                        </div>

                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

                            
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewFile(event) {
            const input = event.target;
            const preview = document.getElementById('previewImage');

            if (input.files && input.files[0]) {
                preview.src = URL.createObjectURL(input.files[0]);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const img = document.getElementById("previewImage");

            if (img) {
                img.addEventListener("error", function () {
                    this.src = '/images/defaults/default-users.png';
                });
            }
        });
    </script>
}
