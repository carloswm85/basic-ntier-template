@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model AddPhoneNumberViewModel

@{
    ViewData["Title"] = "Add Phone Number";
}


<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title mb-3">Add a phone number</h1>
                <hr />

                <form asp-controller="Manage"
                      asp-action="AddPhoneNumber"
                      method="post"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel"
                               inputmode="tel"
                               placeholder="+1 555 123 4567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <a asp-controller="Manage"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Go back
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Send verification code
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
