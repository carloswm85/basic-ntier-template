@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model DisplayRecoveryCodesViewModel

@{
    ViewData["Title"] = "Your recovery codes";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(ViewData["StatusMessage"] as string))
{
    <div class="alert alert-success mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @ViewData["StatusMessage"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title mb-3">
            <i class="bi bi-shield-lock me-2"></i>
            New recovery codes generated
        </h4>

        <hr />

        <div class="alert alert-info border-start border-4 border-secondary">
            <i class="bi bi-info-circle me-2"></i>
            Store these codes in a secure location. Each code can only be used once.
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2 mt-3" id="recoveryCodes">
            @foreach (var code in Model.Codes)
            {
                <div class="col">
                    <div class="border rounded px-3 py-2 text-center font-monospace recovery-code">
                        @code
                    </div>
                </div>
            }
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center gap-2">
            <a asp-controller="Manage"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Go back
            </a>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-outline-primary ms-auto"
                        id="saveCodesBtn">
                    <i class="bi bi-download me-1"></i>
                    Save as .txt
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/recovery-codes.js"></script>
}
