@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.ManageViewModels

@model VerifyPhoneNumberViewModel

@{
    ViewData["Title"] = "Verify Phone Number";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h1 class="h3 mb-3">@ViewData["Title"]</h1>

                    <p class="text-muted">
                        Enter the verification code sent to your phone number.
                    </p>

                    @if (ViewData["Status"] != null)
                    {
                        <div class="alert alert-info">
                            @ViewData["Status"]
                        </div>
                    }

                    <form asp-controller="Manage"
                          asp-action="VerifyPhoneNumber"
                          asp-route-returnurl="@ViewData["ReturnUrl"]"
                          method="post">

                        <input asp-for="PhoneNumber" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   autocomplete="one-time-code" />

                            <span asp-validation-for="Code"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Verify Phone Number
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}