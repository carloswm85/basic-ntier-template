@using CleanArchitectureTemplate.ApplicationCore.Entities
@using CleanArchitectureTemplate.Infrastructure.Authorization.ContactAuthorization
@using CleanArchitectureTemplate.Web.Models.ViewModels.ContactViewModels

@model ContacListViewModel

@{
    ViewData["Title"] = "Contacts Management";
    int rowNumber = 1;
}
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1 class="h4 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">Manage your contacts</p>
                    </div>
                    <a asp-action="Create" class="btn btn-primary">
                        Create new contact
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].Name)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].Address)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].City)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].State)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].Zip)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].Email)</th>
                                <th>@Html.DisplayNameFor(model => model.Contacts[0].Status)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Contacts)
                            {

                                var statusClass = item.Status switch
                                {
                                    ContactStatus.Approved => "bg-success",
                                    ContactStatus.Rejected => "bg-danger",
                                    ContactStatus.Submitted => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td> @(rowNumber++) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Name) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Address) </td>
                                    <td> @Html.DisplayFor(modelItem => item.City) </td>
                                    <td> @Html.DisplayFor(modelItem => item.State) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Zip) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Email) </td>
                                    <td>
                                        <span class="badge @statusClass">
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </span>
                                    </td>

                                    <td class="d-flex">
                                        @if ((await AuthorizationService.AuthorizeAsync(
                                                                            User, item, ContactOperations.Update)).Succeeded)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.ContactId"
                                               class="btn btn-sm btn-outline-primary me-1">
                                                Edit
                                            </a>
                                        }

                                        <a asp-action="Details"
                                           asp-route-id="@item.ContactId"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            Details
                                        </a>

                                        @if ((await AuthorizationService.AuthorizeAsync(
                                                                            User, item, ContactOperations.Delete)).Succeeded)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@item.ContactId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Contacts.Any())
                {
                    <div class="text-center text-muted py-4">
                        No contacts found.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
