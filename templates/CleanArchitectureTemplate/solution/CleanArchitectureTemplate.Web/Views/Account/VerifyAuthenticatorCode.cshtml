@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.AccountViewModels

@model UseRecoveryCodeViewModel

@{
    ViewData["Title"] = "Use recovery code";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 text-center">@ViewData["Title"]</h1>

                @if (ViewData["Status"] != null)
                {
                    <p class="text-muted text-center mb-3">
                        @ViewData["Status"]
                    </p>
                }

                <form asp-controller="Account"
                      asp-action="UseRecoveryCode"
                      asp-route-returnurl="@ViewData["ReturnUrl"]"
                      method="post"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code"
                               class="form-control"
                               autocomplete="one-time-code"
                               autofocus />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Verify recovery code
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
