@using CleanArchitectureTemplate.Web.Models.ViewModels.IdentityViewModels.AccountViewModels

@model VerifyCodeViewModel

@{
    ViewData["Title"] = "Verify";
}

<div class="d-flex align-items-center justify-content-center px-3 m-5">
    <div class="card shadow-sm w-100"
         style="max-width: 420px;">

        <div class="card-body p-4">
            <h1 class="h4 mb-4 text-center">@ViewData["Title"]</h1>

            <form asp-controller="Account"
                  asp-action="VerifyCode"
                  asp-route-returnurl="@ViewData["ReturnUrl"]"
                  method="post"
                  class="row g-3"
                  role="form">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small"></div>

                <input asp-for="Provider" type="hidden" />
                <input asp-for="RememberMe" type="hidden" />

                <div class="col-12">
                    <p class="text-secondary small mb-2 text-center">
                        @ViewData["Status"]
                    </p>
                </div>

                <div class="col-12">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code"
                           class="form-control border-secondary"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           autofocus />
                    <span asp-validation-for="Code"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="RememberBrowser"
                               class="form-check-input border-secondary" />
                        <label asp-for="RememberBrowser"
                               class="form-check-label"></label>
                    </div>
                </div>

                <div class="col-12 d-grid">
                    <button type="submit" class="btn btn-primary">
                        Verify
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
