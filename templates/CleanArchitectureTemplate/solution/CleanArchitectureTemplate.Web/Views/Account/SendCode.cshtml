@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Account

@model SendCodeViewModel

@{
    ViewData["Title"] = "Send Verification Code";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>

                <p class="text-muted mb-4">
                    Choose how you would like to receive your two-factor authentication code.
                </p>

                <form asp-controller="Account"
                      asp-action="SendCode"
                      asp-route-returnurl="@Model.ReturnUrl"
                      method="post"
                      role="form">

                    <input asp-for="RememberMe" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="SelectedProvider" class="form-label">
                            Two-Factor Authentication Provider
                        </label>

                        <select asp-for="SelectedProvider"
                                asp-items="Model.Providers"
                                class="form-select">
                        </select>

                        <span asp-validation-for="SelectedProvider"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            Send Code
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
