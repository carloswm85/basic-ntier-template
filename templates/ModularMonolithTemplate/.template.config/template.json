{
	"$schema": "http://json.schemastore.org/template",
	"author": "Carlos W. Mercado",
	"classifications": [
		"Solution",
		"Monolith",
		"Modular"
	],
	"identity": "Modular.Monolith.Template.CSharp",
	"groupIdentity": "Modular.Monolith.Template",
	"name": "DTK Modular Monolith Template (C#)",
	"shortName": "modular-monolith-template",
	"sourceName": "ModularMonolithTemplate",
	"defaultName": "ModularMonolithProject",
	"tags": {
		"language": "C#",
		"type": "solution",
		"platform": "web"
	},
	"preferNameDirectory": true,
	"description": "A modular solution template with Modular Monolith Architecture.",
	"symbols": {
		"TargetFramework": {
			"type": "parameter",
			"datatype": "choice",
			"replaces": "{{TargetFramework}}",
			"defaultValue": "net10.0",
			"choices": [
				{
					"displayName": ".NET 10.0 (LTS, Current default)",
					"choice": "net10.0"
				}
			],
			"description": "The target framework for the projects."
		},
		"IncludeDocs": {
			"type": "parameter",
			"description": "Include explanatory documentation",
			"datatype": "bool",
			"defaultValue": "false"
		},
		"SolutionGuid": {
			"type": "generated",
			"generator": "guid",
			"replaces": "11111111-1111-1111-1111-111111111111"
		}
	},
	"sources": [
		{
			"source": "./",
			"target": "./",
			"exclude": [
				"**/[Bb]in/**",
				"**/[Oo]bj/**",
				"**/.vs/**",
				"**/.git/**",
				"**/.template.config/**"
			]
		}
	],
	"primaryOutputs": [
		{
			"path": "solution/ModularMonolithTemplate.Module/ModularMonolithTemplate.Module.csproj"
		}
	],
	"postActions": [
		{
			"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
			"manualInstructions": [
				{
					"text": "Run 'dotnet restore'"
				}
			],
			"continueOnError": true,
			"description": "Restore NuGet packages"
		}
	]
}