{
	"$schema": "http://json.schemastore.org/template",
	"author": "Carlos W. Mercado",
	"classifications": [
		"Solution",
		"N-Layer",
		"API",
		"Web"
	],
	"identity": "Basic.NLayer.Template.CSharp",
	"groupIdentity": "Basic.NLayer.Template",
	"name": "DTK Basic N-Layer Template (C#)",
	"shortName": "basic-nlayer-template",
	"sourceName": "BasicNLayerTemplate",
	"defaultName": "BasicNLayerProject",
	"tags": {
		"language": "C#",
		"type": "solution",
		"platform": "web"
	},
	"preferNameDirectory": true,
	"description": "A basic solution template with N-Layer architecture.",
	"symbols": {
		"TargetFramework": {
			"type": "parameter",
			"datatype": "choice",
			"replaces": "{{TargetFramework}}",
			"defaultValue": "net10.0",
			"choices": [
				{
					"displayName": ".NET 10.0 (LTS, Current default)",
					"choice": "net10.0"
				}
			],
			"description": "The target framework for the projects."
		},
		"IncludeDocs": {
			"type": "parameter",
			"description": "Include explanatory documentation",
			"datatype": "bool",
			"defaultValue": "false"
		},
		"SolutionGuid": {
			"type": "generated",
			"generator": "guid",
			"replaces": "11111111-1111-1111-1111-111111111111"
		}
	},
	"sources": [
		{
			"source": "./",
			"target": "./",
			"exclude": [
				"**/[Bb]in/**",
				"**/[Oo]bj/**",
				"**/.vs/**",
				"**/.git/**",
				"**/.template.config/**"
			]
		}
	],
	"primaryOutputs": [
		{
			"path": "solution/BasicNLayerTemplate.API/BasicNLayerTemplate.API.csproj"
		},
		{
			"path": "solution/BasicNLayerTemplate.ApplicationCore/BasicNLayerTemplate.ApplicationCore.csproj"
		},
		{
			"path": "solution/BasicNLayerTemplate.Infrastructure/BasicNLayerTemplate.Infrastructure.csproj"
		},
		{
			"path": "solution/BasicNLayerTemplate.Web/BasicNLayerTemplate.Web.csproj"
		}
	],
	"postActions": [
		{
			"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
			"manualInstructions": [
				{
					"text": "Run 'dotnet restore'"
				}
			],
			"continueOnError": true,
			"description": "Restore NuGet packages"
		}
	]
}