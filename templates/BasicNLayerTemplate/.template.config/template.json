{
	"$schema": "https://json.schemastore.org/template",
	"author": "Carlos W. Mercado",
	"classifications": [
		"Solution",
		"N-Layer",
		"API",
		"Web",
		"ASP.NET"
	],
	"identity": "Basic.NLayer.Template.CSharp",
	"groupIdentity": "Basic.NLayer.Template",
	"name": "DTK Basic N-Layer Template (C#)",
	"shortName": "dtk-basic-nlayer",
	"sourceName": "BasicNLayerTemplate",
	"defaultName": "BasicNLayerProject",
	"tags": {
		"language": "C#",
		"type": "solution",
		"platform": "web"
	},
	"preferNameDirectory": true,
	"description": "A basic solution template with N-Layer architecture.",
	"symbols": {
		"SolutionGuid": {
			"type": "generated",
			"generator": "guid",
			"replaces": "11111111-1111-1111-1111-111111111111"
		},
		"TargetFramework": {
			"type": "parameter",
			"datatype": "choice",
			"replaces": "{{TargetFramework}}",
			"defaultValue": "net10.0",
			"choices": [
				{
					"displayName": ".NET 10.0 (LTS, Current Active)",
					"choice": "net10.0"
				}
			],
			"description": "The target framework for the projects."
		},
		"IncludeDocumentation": {
			"type": "parameter",
			"description": "Include explanatory documentation",
			"datatype": "bool",
			"defaultValue": "false"
		}
	},
	"sources": [
		{
			"source": "./",
			"target": "./",
			"exclude": [
				"**/[Bb]in/**",
				"**/[Oo]bj/**",
				"**/.vs/**",
				"**/.git/**",
				"**/.idea/**",
				"**/.vscode/**",
				"**/*.user",
				"**/*.suo",
				"**/.template.config/**",
				"**/*.cache"
			]
		}
	],
	"primaryOutputs": [
		{
			"path": "./BasicNLayerTemplate.slnx"
		}		
	],
"postActions": [
	{
		"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
		"description": "Restore NuGet packages",
		"continueOnError": true,
		"args": {
			"files": "./SimpleMonolithTemplate.sln"
		},
		"manualInstructions": [
			{
				"text": "Run 'dotnet restore'"
			}
		]
	}
]
}