<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
	<!-- Angular Project
	<SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
	<SpaRoot>..\BasicNtierTemplate.Web.Angular</SpaRoot>
	<SpaProxyServerUrl>https://localhost:5021</SpaProxyServerUrl>
	-->
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
	<PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.1" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.1" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\BasicNtierTemplate.Data\BasicNtierTemplate.Data.csproj" />
	<ProjectReference Include="..\BasicNtierTemplate.Repository\BasicNtierTemplate.Repository.csproj" />
	<ProjectReference Include="..\BasicNtierTemplate.Service\BasicNtierTemplate.Service.csproj" />
  </ItemGroup>

</Project>
