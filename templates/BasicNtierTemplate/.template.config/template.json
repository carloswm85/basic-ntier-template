{
	"$schema": "http://json.schemastore.org/template",
	"author": "Carlos W. Mercado",
	"classifications": [
		"Solution",
		"Clean Architect Variant",
		"N-Tier",
		"N-Layer",
		"API",
		"Web"
	],
	"identity": "Basic.Ntier.Template.CSharp",
	"groupIdentity": "Basic.Ntier.Template",
	"name": "Basic N-Tier Template (C#)",
	"shortName": "basic-ntier-template",
	"sourceName": "BasicNtierTemplate",
	"defaultName": "BasicNtierProject",
	"tags": {
		"language": "C#",
		"type": "solution",
		"platform": "web"
	},
	"preferNameDirectory": true,
	"description": "A basic solution template with N-Tier architecture.",
	"symbols": {
		"TargetFramework": {
			"type": "parameter",
			"datatype": "choice",
			"replaces": "{{TargetFramework}}",
			"defaultValue": "net10.0",
			"choices": [
				{
					"displayName": ".NET 10.0 (LTS, Current default)",
					"choice": "net10.0"
				}
			],
			"description": "The target framework for the projects."
		},
		"IncludeDocs": {
			"type": "parameter",
			"description": "Include explanatory documentation",
			"datatype": "bool",
			"defaultValue": "false"
		},
		"SolutionGuid": {
			"type": "generated",
			"generator": "guid",
			"replaces": "11111111-1111-1111-1111-111111111111"
		}
	},
	"sources": [
		{
			"source": "./",
			"target": "./",
			"exclude": [
				"**/[Bb]in/**",
				"**/[Oo]bj/**",
				"**/.vs/**",
				"**/.git/**",
				"**/.template.config/**"
			]
		}
	],
	"primaryOutputs": [
		{
			"path": "BasicNtierTemplate.API/BasicNtierTemplate.API.csproj"
		},
		{
			"path": "BasicNtierTemplate.Service/BasicNtierTemplate.Service.csproj"
		},
		{
			"path": "BasicNtierTemplate.Repository/BasicNtierTemplate.Repository.csproj"
		},
		{
			"path": "BasicNtierTemplate.Data/BasicNtierTemplate.Data.csproj"
		}
	],
	"postActions": [
		{
			"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
			"manualInstructions": [
				{
					"text": "Run 'dotnet restore'"
				}
			],
			"continueOnError": true,
			"description": "Restore NuGet packages"
		}
	]
}